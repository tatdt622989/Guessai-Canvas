# Local development: npm run dev (http://localhost:3010)
PORT=3010
PUBLIC_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/guessai_canvas_dev
GUESSAI_GUEST_SECRET=any-long-local-secret
GEMINI_API_KEY=
RECAPTCHA_SECRET_KEY=
UPLOAD_DIR=./uploads
STATIC_DIR=../dist
# Admin pages (/admin). Make the hash with: node scripts/hash-password.js
GUESSAI_ADMIN_PASSWORD_HASH=
# At least 32 characters, e.g. openssl rand -base64 32
GUESSAI_SESSION_SECRET=
# true while players move their pass from api.6yuwei.com (90 days)
HANDOFF_ENABLED=false
